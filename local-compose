#!/usr/bin/env bash
set -euo pipefail
chmod +x ./monolith-compose ./gradlew

# 파일 확인
if [[ ! -f "docker-compose-local.yml" ]]; then
  echo "docker-compose-local.yml 이(가) 프로젝트 루트에 필요합니다."
  exit 1
fi

# 0) Base image 사전 준비
echo "Base image 확인 중..."
docker image inspect openjdk:21-slim >/dev/null 2>&1 || docker pull openjdk:21-slim
docker image inspect gradle:8.10.1-jdk21 >/dev/null 2>&1 || docker pull gradle:8.10.1-jdk21

if [[ ! -f monolith/main-runner/build/libs/main-runner-0.0.1-SNAPSHOT.jar ]]; then
  echo "main-runner JAR이 없어 빌드합니다..."
  ./gradlew --version
  docker run --rm \
    -v "$PWD":/workspace \
    -v "$HOME/.gradle":/home/gradle/.gradle \
    -w /workspace \
    gradle:8.10.1-jdk21 \
    ./gradlew :main-runner:bootJar --no-daemon
fi

# 1) 인프라 기동
./monolith-compose up -d

# 2) 인프라 헬스웨이트
services=("demo_postgres14" "demo_redis")
echo "인프라 헬스체크 대기 중..."
for s in "${services[@]}"; do
  echo -n " - $s: "
  tries=0
  until [[ "$(docker inspect -f '{{.State.Health.Status}}' "$(docker compose -f docker-compose-monolith.yml ps -q "$s")" 2>/dev/null || echo starting)" == "healthy" ]]; do
    tries=$((tries+1))
    if (( tries > 180 )); then
      echo "시간 초과(≈15분). 상태를 확인하세요."
      exit 1
    fi
    echo -n "."
    sleep 5
  done
  echo " OK"
done

# 3) 앱 기동
docker compose -f docker-compose-local.yml up -d --build
echo "로컬 앱 기동 완료: http://localhost:8080"
